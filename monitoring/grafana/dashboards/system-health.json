    { "datasource": "Prometheus", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }, "id": 1, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }, "title": "Uptime", "type": "stat", "targets": [{ "expr": "avg(up)", "legendFormat": "Uptime", "refId": "A" }] },
